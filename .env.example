# Copy to .env.local (local) or set these in your hosting provider (production).
# Without the Supabase variables the app uses the local file driver (.data/).

# --- Supabase (required in production) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions (required in production): random value, at least 32 characters ---
SESSION_SECRET=

# --- First-time setup (required in production): one-time code asked on /setup ---
SETUP_CODE=

# --- Optional: AI tagging of uploaded photos ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional: folder of the local file driver ---
# DATA_DIR=.data
